; A made-up hledger journal for tests, with a decimal comma.
; Every name and number is invented.
decimal-mark ,
commodity 1.000,00 EUR
account assets:banca:conto     ; type: A
account liabilities:mutuo      ; type: L
account income:stipendio       ; type: R

2024-01-01 opening balances
    assets:banca:conto          10.000,00 EUR
    liabilities:mutuo         -150.000,00 EUR
    equity:opening

2024-01-27 stipendio  ; payee:Employer
    assets:banca:conto           2.000,50 EUR  ; date:2024-01-28
    income:stipendio

2024-01-31 rata mutuo
    liabilities:mutuo              600 EUR
    expenses:interessi             150 EUR
    assets:banca:conto          = 11.250,50 EUR

2024-02-01 checks that pass
    assets:banca:conto           0 EUR = 11.250,50 EUR
    liabilities:mutuo            0 EUR == -149.400,00 EUR

2024-02-02 a check that fails
    assets:banca:conto         -50 EUR = 11.000,00 EUR
    expenses:varie

2024-02-03 ETF
    assets:broker            3 "VWCE.MI" @ 105,5 EUR
    assets:banca:conto

2024-02-04 * crypto, price inferred
    assets:crypto          0,01 BTC
    assets:banca:conto    -400 EUR

P 2024-02-29 "VWCE.MI" 107,25 EUR
