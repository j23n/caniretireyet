// The project's build settings under project.yml's own. Your Apple Developer team and bundle
// identifier go in Signing.xcconfig at the repository's root, which git ignores and XcodeGen never
// rewrites, so every newly generated project keeps them (j23n/apple-ci README.md, "Signing"):
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   APP_BUNDLE_IDENTIFIER = com.yourdomain.caniretireyet
//
// make signing TEAM=ABCDE12345 writes the team line. Without the file the project has no team and
// the example identifier, as in CI.

DEVELOPMENT_TEAM =
APP_BUNDLE_IDENTIFIER = com.example.caniretireyet

#include? "../../Signing.xcconfig"
