    "Acquisto": "buy",
    "Bonifico in entrata": "deposit",
    "Commissioni": "fee",
    "Dividendo": "dividend",
    "Giroconto": "ignore",
    "Imposta di bollo": "tax",
    "Ritenuta su dividendo": "tax",
    "Vendita": "sell"
  }
}
